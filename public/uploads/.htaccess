# User uploads: files here may NEVER run as code (stops web-shell/backdoor uploads)
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .pl .py .cgi
RemoveType .php .phtml .phar
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

# Allow only plain image files
<FilesMatch "\.(?i:jpe?g|png|webp)$">
    Require all granted
</FilesMatch>
<FilesMatch "^(?!.*\.(?i:jpe?g|png|webp)$).*$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'none'; sandbox"
</IfModule>
