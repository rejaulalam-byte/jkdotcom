# Copy this file to ".env" on the server and fill in real values.
# ".env" must NEVER be committed to GitHub (it is listed in .gitignore).

# production | local
APP_ENV=production
APP_URL=https://jorurikaj.com
# Long random secret (used to hash IP addresses etc). Generate: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# MySQL (cPanel > MySQL Databases). Leave DB_NAME empty to run in demo mode with sample data.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Feedback form: who receives the e-mail, and the sender address (must exist on your domain)
MAIL_TO=info@jorurikaj.com
MAIL_FROM=no-reply@jorurikaj.com

# রেজিস্ট্রেশন আবেদনের ইমেইল (ছবিসহ) যেখানে জমা হয়
MAIL_REGISTRATION_TO=registration@jorurikaj.com

# অ্যাডমিন প্যানেলের প্রথম সুপার অ্যাডমিন বানানোর গোপন কী (/admin/setup)। শুধু একবার লাগে; অ্যাডমিন তৈরি হলে পেইজ বন্ধ।
# নিজের দীর্ঘ এলোমেলো একটা লেখা দিন এবং কাউকে জানাবেন না। তৈরির পর লাইনটা মুছে ফেলতে পারেন।
ADMIN_SETUP_KEY=

# অ্যাডমিন প্যানেলের গোপন প্রবেশপথ (শুধু ইংরেজি ছোট অক্ষর, সংখ্যা, - বা _; কমপক্ষে ৩ অক্ষর)। যেমন ADMIN_PATH=my-secret-door
# তখন প্যানেল খুলবে https://সাইট/my-secret-door এ; সাধারণ /admin তখন ৪০৪ দেবে। খালি রাখলে লোকালে /admin।
ADMIN_PATH=

# কর্মীদের (সুপার অ্যাডমিন ছাড়া মেইন, অ্যাডমিনিস্ট্রেটর, সাব-অ্যাডমিন) আলাদা দরজা, একই ধাঁচে এবং ADMIN_PATH থেকে আলাদা। খালি রাখলে সবাই ADMIN_PATH-ই ব্যবহার করে।
# দিলে: সুপার শুধু ADMIN_PATH দিয়ে, বাকিরা শুধু এই পথ দিয়ে ঢুকতে পারেন; কর্মীরা সুপারের পথ কখনো দেখেন না।
ADMIN_PATH_STAFF=
